generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String           @id @default(uuid())
  name                 String
  email                String           @unique
  phone                String
  password             String?
  role                 String           @default("Funcionario")
  status               String           @default("Ativo")
  last                 String?
  initials             String
  failedLoginAttempts  Int              @default(0)
  lockedUntil          DateTime?
  serviceIds           String[]         @default([])
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  appointments         Appointment[]
  appointmentReviews   AppointmentReview[]
  permissions          UserPermission[]
  sales                Sale[]

  @@map("Users")
}

model UserPermission {
  id                 Int      @id @default(autoincrement())
  name               String
  userId             String
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  description        String?
  enabled            Boolean  @default(true)
  isSystemPermission Boolean  @default(false)
  viewReports        Boolean  @default(false) @map("Ver_Relatorios")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([userId, name])
  @@map("UserPermissions")
}

model SystemPermission {
  id                 Int      @id @default(autoincrement())
  name               String   @unique
  description        String?
  category           String   @default("general")
  enabled            Boolean  @default(true)
  requiresHierarchy  Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("SystemPermissions")
}

model Product {
  id        String   @id @default(uuid())
  name      String
  category  String
  price     Float
  quantity  Int
  status    String   @default("Ativo")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sales     Sale[]

  @@map("Products")
}

enum PortalAccess {
  WAITING
  IN_REVIEW
  APPROVED
}

model Client {
  portalAccess PortalAccess @default(WAITING)
  portalApprovedAt DateTime?
  portalApprovedById String?
  id           String        @id @default(uuid())
  name         String
  email        String        @unique
  phone        String
  /// Senha do portal do cliente (bcrypt). Nulo = cadastro feito internamente, sem acesso ao portal.
  password     String?
  birthDate    String?
  status       String        @default("Ativo")
  initials     String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  appointments Appointment[]
  oauthAccounts ClientOAuthAccount[]
  passwordResetTokens ClientPasswordResetToken[]
  appointmentReviews AppointmentReview[]

  @@map("Clients")
}

/// Identidade de provedor externo (Google) vinculada a um Client existente.
/// Não é uma conta separada: só aponta para o Client dono do login.
model ClientOAuthAccount {
  id                String   @id @default(uuid())
  clientId          String
  client            Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  provider          String
  providerAccountId String
  createdAt         DateTime @default(now())

  @@unique([provider, providerAccountId])
  @@index([clientId])
  @@map("ClientOAuthAccounts")
}

/// Token de redefinição de senha do portal. Guarda o hash (sha256), não o
/// token puro — se o banco vazar, o token não é reutilizável direto.
model ClientPasswordResetToken {
  id        String    @id @default(uuid())
  clientId  String
  client    Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  issuedEmail String?
  originHash String?
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([clientId, createdAt])
  @@index([originHash, createdAt])
  @@index([clientId])
  @@map("ClientPasswordResetTokens")
}

model Service {
  id           String        @id @default(uuid())
  name         String
  description  String?
  duration     Int
  price        Float?
  status       String        @default("Ativo")
  color        String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  appointments Appointment[]

  @@map("Services")
}

model AppointmentStatus {
  id           String        @id @default(uuid())
  name         String        @unique
  description  String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  appointments Appointment[]

  @@map("AppointmentStatuses")
}

model Appointment {
  id           String             @id @default(uuid())
  date         String
  time         String
  name         String
  service      String?
  duration     String
  status       String             @default("Confirmado")
  statusId     String?
  statusRecord AppointmentStatus? @relation(fields: [statusId], references: [id], onDelete: SetNull)
  initials     String
  channelId    String
  notes        String?
  userId       String?
  user         User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  clientId     String?
  client       Client?            @relation(fields: [clientId], references: [id], onDelete: SetNull)
  serviceId    String?
  serviceRecord Service?          @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  paymentMethod String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  review       AppointmentReview?

  @@index([date])
  @@index([status])
  @@index([statusId])
  @@index([userId])
  @@index([clientId])
  @@index([serviceId])
  @@map("Appointments")
}

model AppointmentReview {
  id            String      @id @default(uuid())
  appointmentId String      @unique
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  clientId      String
  client        Client      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  attendantId   String
  attendant     User        @relation(fields: [attendantId], references: [id], onDelete: Restrict)
  rating        Int?
  reviewedAt    DateTime?
  dismissedAt   DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([clientId, reviewedAt, dismissedAt])
  @@map("AppointmentReviews")
}

model AppointmentChannel {
  id      String  @id
  name    String
  value   Int
  percent Float
  digital Boolean

  @@map("AppointmentChannels")
}

model Sale {
  id            String   @id @default(uuid())
  productId     String
  product       Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  quantity      Int
  unitPrice     Float
  totalPrice    Float

  paymentMethod String   @default("Dinheiro")

  createdById   String?
  createdBy     User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([createdAt])
  @@index([productId])
  @@index([createdById])
  @@map("Sales")
}
